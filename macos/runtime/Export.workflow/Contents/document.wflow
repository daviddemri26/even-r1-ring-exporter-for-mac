				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>set -eu
umask 077
base="$HOME/Library/Application Support/R1 Bridge"
helper="$base/Export.workflow/Contents/Resources/R1 Bridge Collector.app"
run_dir=$(/usr/bin/mktemp -d "$base/.export-run.XXXXXXXX")
trap '/bin/rm -f "$run_dir/status" "$run_dir/manifest"; /bin/rmdir "$run_dir" 2&gt;/dev/null || true' EXIT
/usr/bin/open -b com.even.sg
/usr/bin/open -n -g -W -a "$helper" --args "$run_dir"
if [[ ! -f "$run_dir/status" ]]; then
    print -u2 -- 'Even R1: helper did not complete'
    exit 1
fi
result=$(&lt;"$run_dir/status")
if [[ "$result" != "OK" ]]; then
    print -u2 -- "Even R1: $result"
    exit 1
fi</string>
					<key>CheckedForUserDefaultShell</key>
					<true/>
					<key>inputMethod</key>
					<integer>0</integer>
					<key>shell</key>
					<string>/bin/zsh</string>
